<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Analyst Portfolio</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent-color: #38bdf8;
            --text-color: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 2rem;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .portfolio-container {
            max-width: 800px;
            width: 100%;
        }

        header {
            text-align: center;
            margin-bottom: 3rem;
        }

        h1 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
            color: var(--text-color);
        }

        p.subtitle {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1.5rem;
        }

        .project-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .project-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
        }

        .project-card h3 {
            margin-top: 0;
            color: var(--accent-color);
        }

        .project-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.5;
        }

        .btn {
            display: inline-block;
            background-color: var(--accent-color);
            color: var(--bg-color);
            padding: 0.6rem 1.2rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            margin-top: 1rem;
            transition: opacity 0.2s ease;
        }

        .btn:hover {
            opacity: 0.9;
        }
    </style>
</head>
<body>

    <div class="portfolio-container">
        <header>
            <h1>Data Analyst Portfolio</h1>
            <p class="subtitle">Showcasing SQL queries, datasets, and insights</p>
        </header>

        <div class="projects-grid">
            <!-- Project 1: Cedar Point Example -->
            <div class="project-card">
                <h3>Cedar Point Rides Analysis</h3>
                <p>An in-depth SQL and data visualization project analyzing wait times, coaster stats, and park data.</p>
                <!-- Clickable Button -->
                <a href="image.png" target="_blank" class="btn">View Project</a>
            </div>

            <!-- Project 2: Placeholder for your next project -->
            <div class="project-card">
                <h3>Future Data Project</h3>
                <p>Coming soon! Space reserved for your next awesome SQL data analytics breakdown.</p>
                <!-- Clickable Button -->
                <a href="#" class="btn">Coming Soon</a>
            </div>
        </div>
    </div>

</body>
</html>
